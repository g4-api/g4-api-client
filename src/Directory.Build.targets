<Project>

	<!--
		TEMPORARY - feature/parallel-execution. Delete this file when the engine with the Parallel container is released,
		and set the released versions in the project files instead.

		Points every project under src at the engine built from the local, uncommitted g4-engine working tree
		(branch feature/parallel-execution). The packages are packed into the local feed of the g4-services repository,
		g4-services/artifacts/local-feed, which git ignores and which the Hub reads too.

		To refresh after an engine change, raise the number in G4EngineLocalVersion below and pack the engine again with
		the same version, from the g4-services folder (so the .NET 10 SDK pinned by global.json is used):

			foreach ($name in 'G4.Attributes','G4.Converters','G4.Exceptions','G4.Extensions','G4.Settings','G4.Models','G4.Cache','G4.Credentials','G4.Plugins') {
				dotnet pack ..\g4-engine\src\$name\$name.csproj -c Release -p:Version=<version> -o artifacts\local-feed
			}

		To hand this client to the Hub, pack it into the same feed, from this repository's folder, and set the version in
		g4-services/src/Directory.Build.targets:

			dotnet pack src\G4.Api\G4.Api.csproj -c Release -p:Version=<version> -o ..\g4-services\artifacts\local-feed
	-->
	<PropertyGroup>
		<G4EngineLocalVersion>2026.11.21.2-parallel</G4EngineLocalVersion>
		<G4LocalFeed>$(MSBuildThisFileDirectory)..\..\g4-services\artifacts\local-feed</G4LocalFeed>
		<RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(G4LocalFeed)</RestoreAdditionalProjectSources>
	</PropertyGroup>

	<!-- Only the engine packages the projects reference directly; the rest follow as their dependencies. -->
	<ItemGroup>
		<PackageReference Update="G4.Cache" Version="$(G4EngineLocalVersion)" />
		<PackageReference Update="G4.CredentialsManager" Version="$(G4EngineLocalVersion)" />
		<PackageReference Update="G4.Plugins" Version="$(G4EngineLocalVersion)" />
	</ItemGroup>

</Project>
